<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:clipToPadding="false"
    android:padding="@dimen/dialog_padding">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ssl_info_connection"
        android:textAppearance="?android:attr/textAppearanceListItemSmall"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/ssl_layout_connection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/material_grid_unit"
        android:paddingStart="@dimen/material_grid_unit"
        android:textAppearance="?android:attr/textAppearanceListItemSmall"
        tools:text="Secure (HTTPS)" />

    <TextView
        android:id="@+id/ssl_label_issued_by"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/material_grid_margin"
        android:text="@string/ssl_info_issued_by"
        android:textAppearance="?android:attr/textAppearanceListItemSmall"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/ssl_layout_issue_by"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/material_grid_unit"
        android:paddingStart="@dimen/material_grid_unit"
        android:textAppearance="?android:attr/textAppearanceListItemSmall"
        tools:text="Test Cert Authority" />

    <TextView
        android:id="@+id/ssl_label_issued_to"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/material_grid_margin"
        android:text="@string/ssl_info_issued_to"
        android:textAppearance="?android:attr/textAppearanceListItemSmall"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/ssl_layout_issue_to"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/material_grid_unit"
        android:paddingStart="@dimen/material_grid_unit"
        android:textAppearance="?android:attr/textAppearanceListItemSmall"
        tools:text="Test Company" />

    <TextView
        android:id="@+id/ssl_label_issued_on"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/material_grid_margin"
        android:text="@string/ssl_info_issued_on"
        android:textAppearance="?android:attr/textAppearanceListItemSmall"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/ssl_layout_issue_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/material_grid_unit"
        android:paddingStart="@dimen/material_grid_unit"
        android:textAppearance="?android:attr/textAppearanceListItemSmall"
        tools:text="today" />

    <TextView
        android:id="@+id/ssl_label_expires_on"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/material_grid_margin"
        android:text="@string/ssl_info_expires_on"
        android:textAppearance="?android:attr/textAppearanceListItemSmall"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/ssl_layout_expire_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/material_grid_unit"
        android:paddingStart="@dimen/material_grid_unit"
        android:textAppearance="?android:attr/textAppearanceListItemSmall"
        tools:text="tomorrow" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/material_grid_margin"
        android:text="@string/ssl_rank_tranco"
        android:textAppearance="?android:attr/textAppearanceListItemSmall"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/ssl_layout_rank_tranco"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/material_grid_unit"
        android:paddingStart="@dimen/material_grid_unit"
        android:textAppearance="?android:attr/textAppearanceListItemSmall"
        tools:text="#1,234" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/material_grid_margin"
        android:text="@string/ssl_rank_majestic"
        android:textAppearance="?android:attr/textAppearanceListItemSmall"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/ssl_layout_rank_majestic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/material_grid_unit"
        android:paddingStart="@dimen/material_grid_unit"
        android:textAppearance="?android:attr/textAppearanceListItemSmall"
        tools:text="#567" />

    <TextView
        android:id="@+id/algorithm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/material_grid_margin"
        android:text="@string/algorithm"
        android:textAppearance="?android:attr/textAppearanceListItemSmall"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/ssl_layout_serial_number"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/material_grid_unit"
        android:paddingStart="@dimen/material_grid_unit"
        android:textAppearance="?android:attr/textAppearanceListItemSmall"
        tools:text="tomorrow" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/material_grid_margin"
        android:text="@string/ssl_info_cookies"
        android:textAppearance="?android:attr/textAppearanceListItemSmall"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/ssl_layout_cookies"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/material_grid_unit"
        android:paddingStart="@dimen/material_grid_unit"
        android:textAppearance="?android:attr/textAppearanceListItemSmall"
        tools:text="4 stored for this site" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/material_grid_margin"
        android:text="@string/ssl_info_blocking"
        android:textAppearance="?android:attr/textAppearanceListItemSmall"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/ssl_layout_blocking"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/material_grid_unit"
        android:paddingStart="@dimen/material_grid_unit"
        android:textAppearance="?android:attr/textAppearanceListItemSmall"
        tools:text="Enabled for this site" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/material_grid_margin"
        android:text="@string/ssl_info_javascript"
        android:textAppearance="?android:attr/textAppearanceListItemSmall"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/ssl_layout_javascript"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/material_grid_unit"
        android:paddingStart="@dimen/material_grid_unit"
        android:textAppearance="?android:attr/textAppearanceListItemSmall"
        tools:text="Allowed on this site" />
    </LinearLayout>

</ScrollView>
