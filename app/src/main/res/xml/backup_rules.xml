<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup rules for API 30 and below (fullBackupContent).
     SEC15 — the database domain is included again: arktos.db is now
     SQLCipher ciphertext keyed by an Android Keystore-wrapped key
     (keystore keys are never backed up), so a cloud copy is inert
     ciphertext. The wrapped-key blob (files/arktos_store.key) is
     ciphertext too — restoring it without the device keystore just
     yields an undecryptable DB that openStore quarantines. The
     password-protected restore path stays the in-app encrypted backup
     (Settings → Import/Export → Encrypted backup). Shared prefs carry
     only settings + argon2id credential hashes. Files are included
     minus regenerable bulk (downloaded rank lists, adblock caches,
     generated pages) that would exhaust the 25MB quota. -->
<full-backup-content>
    <include domain="sharedpref" path="." />
    <include domain="database" path="." />
    <include domain="file" path="." />
    <exclude domain="file" path="site-rank" />
    <exclude domain="file" path="adblock_subscriptions" />
    <exclude domain="file" path="homepage.html" />
    <exclude domain="file" path="private.html" />
    <exclude domain="file" path="downloads.html" />
    <exclude domain="root" path="app_webview" />
</full-backup-content>
