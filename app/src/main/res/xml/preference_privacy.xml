<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:title="@string/privacy_set">
        <SwitchPreference
            android:defaultValue="true"
            android:key="location"
            android:singleLineTitle="false"
            android:title="@string/location"/>
        <SwitchPreference
            android:defaultValue="true"
            android:key="cb_javascript"
            android:singleLineTitle="false"
            android:title="@string/java"/>
        <Preference
            android:key="block_javascript"
            android:singleLineTitle="false"
            android:title="@string/block_javascript"/>
        <SwitchPreference
            android:defaultValue="true"
            android:key="allow_cookies"
            android:singleLineTitle="false"
            android:summary="@string/recommended"
            android:title="@string/cookies" />
        <SwitchPreference
            android:defaultValue="false"
            android:key="third_party"
            android:singleLineTitle="false"
            android:title="@string/third_party"/>
        <SwitchPreference
            android:defaultValue="false"
            android:key="incognito_cookies"
            android:singleLineTitle="false"
            android:title="@string/incognito_cookies" />
        <SwitchPreference
            android:defaultValue="true"
            android:key="password"
            android:singleLineTitle="false"
            android:summary="@string/enable_in_settings"
            android:title="@string/password"/>
        <SwitchPreference
            android:defaultValue="false"
            android:key="do_not_track"
            android:singleLineTitle="false"
            android:title="@string/do_not_track"/>
        <SwitchPreference
            android:defaultValue="false"
            android:singleLineTitle="false"
            android:key="remove_identifying_headers"
            android:title="@string/remove_identifying_headers"/>
        <SwitchPreference
            android:defaultValue="false"
            android:singleLineTitle="false"
            android:key="webrtc_support"
            android:title="@string/webrtc_support"
            android:summary="@string/webrtc_description"/>
        <SwitchPreference
            android:defaultValue="false"
            android:key="start_incognito"
            android:singleLineTitle="false"
            android:title="@string/start_incognito"/>
        <Preference
            android:fragment="com.arktosbrowser.mobile.settings.fragment.ListsSettingsFragment"
            android:key="lists_settings"
            android:singleLineTitle="false"
            android:summary="@string/lists_settings_summary"
            android:title="@string/lists_settings_title"/>
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/security_set">
        <Preference
            android:key="proxy"
            android:singleLineTitle="false"
            android:title="@string/http_proxy"/>
        <Preference
            android:key="agent"
            android:singleLineTitle="false"
            android:title="@string/agent"/>
        <SwitchPreference
            android:defaultValue="true"
            android:key="show_ssl"
            android:singleLineTitle="false"
            android:title="@string/show_ssl"
            android:summary="@string/warn"/>
        <SwitchPreference
            android:defaultValue="false"
            android:key="prefer_https"
            android:singleLineTitle="false"
            android:summary="@string/preferhttpsdesc"
            android:title="@string/preferhttps"/>
        <SwitchPreference
            android:defaultValue="false"
            android:key="force_https"
            android:singleLineTitle="false"
            android:summary="@string/forcehttpsdesc"
            android:title="@string/forcehttps"/>
        <SwitchPreference
            android:defaultValue="true"
            android:singleLineTitle="false"
            android:key="block_malicious_sites"
            android:title="@string/block_malware"/>
        <SwitchPreference
            android:defaultValue="true"
            android:singleLineTitle="false"
            android:key="block_lan_requests"
            android:summary="@string/block_lan_requests_summary"
            android:title="@string/block_lan_requests"/>
        <SwitchPreference
            android:defaultValue="true"
            android:singleLineTitle="false"
            android:key="block_mixed_content"
            android:summary="@string/block_mixed_content_summary"
            android:title="@string/block_mixed_content"/>
        <SwitchPreference
            android:defaultValue="false"
            android:singleLineTitle="false"
            android:key="secure_windows"
            android:summary="@string/secure_windows_summary"
            android:title="@string/secure_windows"/>
        <SwitchPreference
            android:defaultValue="true"
            android:singleLineTitle="false"
            android:key="show_punycode"
            android:summary="@string/show_punycode_summary"
            android:title="@string/show_punycode"/>
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/privacy_data_category">
        <SwitchPreference
            android:defaultValue="false"
            android:key="clear_cache_exit"
            android:singleLineTitle="false"
            android:title="@string/cache"/>
        <SwitchPreference
            android:defaultValue="false"
            android:key="clear_history_exit"
            android:singleLineTitle="false"
            android:title="@string/clear_history_exit"/>
        <SwitchPreference
            android:defaultValue="false"
            android:key="clear_cookies_exit"
            android:singleLineTitle="false"
            android:title="@string/clear_cookies_exit"/>
        <SwitchPreference
            android:defaultValue="false"
            android:key="clear_webstorage_exit"
            android:singleLineTitle="false"
            android:title="@string/clear_web_storage_exit"/>
        <SwitchPreference
            android:defaultValue="true"
            android:key="only_clear"
            android:singleLineTitle="false"
            android:title="@string/only_clear"
            android:summary="@string/only_clear_summary"/>
        <Preference
            android:key="app_lock"
            android:singleLineTitle="false"
            android:summary="@string/app_lock_summary"
            android:title="@string/app_lock"/>
        <Preference
            android:key="app_lock_delay"
            android:singleLineTitle="false"
            android:title="@string/lock_after"/>
        <SwitchPreference
            android:defaultValue="true"
            android:key="panic_trigger"
            android:singleLineTitle="false"
            android:summary="@string/panic_trigger_summary"
            android:title="@string/panic_trigger"/>
        <Preference
            android:key="clear_cache"
            android:singleLineTitle="false"
            android:title="@string/clear_cache"/>
        <Preference
            android:key="clear_history"
            android:singleLineTitle="false"
            android:title="@string/clear_history"/>
        <Preference
            android:key="clear_cookies"
            android:singleLineTitle="false"
            android:title="@string/clear_cookies"/>
        <Preference
            android:key="clear_webstorage"
            android:singleLineTitle="false"
            android:title="@string/clear_web_storage"/>
    </PreferenceCategory>
</PreferenceScreen>
