<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.preference.PreferenceCategory android:title="@string/sync_status_title">
        <androidx.preference.Preference
            android:key="pref_sync_status"
            android:title="@string/sync_status_not_connected" />
        <androidx.preference.Preference
            android:title="@string/sync_this_device"
            android:key="pref_sync_device_name" />
        <androidx.preference.Preference
            android:summary="@string/sync_coming_soon"
            android:key="pref_sync_note" />
    </androidx.preference.PreferenceCategory>

    <androidx.preference.PreferenceCategory android:title="@string/sync_paired_devices">
        <androidx.preference.Preference
            android:summary="@string/sync_no_devices"
            android:key="pref_sync_device_list" />
        <androidx.preference.Preference
            android:title="@string/sync_pair_button"
            android:key="pref_sync_pair" />
        <androidx.preference.Preference
            android:title="@string/sync_join_button"
            android:summary="@string/sync_join_hint"
            android:key="pref_sync_join" />
        <androidx.preference.Preference
            android:key="pref_sync_join_status"
            android:title="@string/sync_joining"
            android:iconSpaceReserved="false"
            app:widgetLayout="@layout/sync_join_progress"
            android:persistent="false" />
    </androidx.preference.PreferenceCategory>

    <androidx.preference.PreferenceCategory android:title="@string/sync_data_title">
        <androidx.preference.Preference
            android:title="@string/sync_passwords_title"
            android:key="pref_sync_passwords" />
        <androidx.preference.Preference
            android:title="@string/sync_remote_tabs_title"
            android:key="pref_sync_remote_tabs" />
    </androidx.preference.PreferenceCategory>

    <androidx.preference.PreferenceCategory android:title="@string/sync_options_title">
        <androidx.preference.ListPreference
            android:key="pref_sync_interval"
            android:title="@string/sync_interval_title"
            android:entries="@array/sync_interval_entries"
            android:entryValues="@array/sync_interval_values"
            android:defaultValue="15" />
        <androidx.preference.Preference
            android:key="pref_sync_now"
            android:title="@string/sync_now_title" />
    </androidx.preference.PreferenceCategory>
</androidx.preference.PreferenceScreen>
